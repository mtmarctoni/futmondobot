# ---- Futmondo credentials (required) ----
FUTMONDO_EMAIL=you@example.com
FUTMONDO_PASSWORD=your-password

# ---- Optional: explicit IDs (auto-discovered from /api/futmondo otherwise) ----
# FUTMONDO_CHAMPIONSHIP_ID=...
# FUTMONDO_USER_TEAM_ID=...
# FUTMONDO_LEAGUE_ID=...

# Current funds in euros. Used for buy affordability checks.
# FUTMONDO_FUNDS=210000000

# Matchday deadline (ISO 8601). Used for reminders.
# FUTMONDO_DEADLINE=2026-09-06T21:00:00Z

# ---- Telegram bot (required for reminders) ----
# Create a bot with @BotFather and get the token.
TELEGRAM_BOT_TOKEN=123456:ABC-def
# One or more comma-separated numeric chat ids (get yours from @userinfobot).
TELEGRAM_CHAT_ID=123456789

# Secret shared with Telegram webhook + cron (protects /api/telegram and /api/cron/*).
# CRON_SECRET=change-me

# ---- Optional: stats provider (API-Football free tier via RapidAPI) ----
# Adds fixture difficulty to lineups. Optional — features degrade gracefully.
# API_FOOTBALL_KEY=xxxxxxxx
# LEAGUE_ID=140

# Opt-in to Vercel build telemetry
# NEXT_TELEMETRY_DISABLED=1
