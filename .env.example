# ---- Futmondo credentials (required) ----
# The only secrets the app needs. Used server-side only, never sent to the browser.
FUTMONDO_EMAIL=you@example.com
FUTMONDO_PASSWORD=your-password

# ---- Database (required) ----
# History is where every edge comes from: the API only ever reports today, so
# value trends, real form, clause prices and rival funds all need storage.
# Provisioned automatically by `vercel integration add neon`, then pulled with
# `vercel env pull .env.local`.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ---- Route protection (required) ----
# Guards /api/sync, /api/cron/* and /api/futmondo. These can write to Futmondo,
# so an unset secret disables them rather than leaving them open.
CRON_SECRET=change-me

# ---- Telegram (recommended) ----
# Create a bot with @BotFather for the token; get your chat id from @userinfobot.
# TELEGRAM_CHAT_ID is an allowlist: only these chats can command the bot, and an
# empty value means nobody can. Comma-separate for several.
TELEGRAM_BOT_TOKEN=123456:ABC-def
TELEGRAM_CHAT_ID=123456789
# Defaults to CRON_SECRET if unset.
# TELEGRAM_WEBHOOK_SECRET=

# ---- Optional ----
# Only needed when the account has more than one championship, or when
# auto-discovery picks the wrong team. Find both via GET /api/futmondo.
# FUTMONDO_CHAMPIONSHIP_ID=
# FUTMONDO_USER_TEAM_ID=

# How close to the deadline the lineup is written. Writing early wastes the
# change, since injuries and probable lineups keep moving. Default 30.
# LINEUP_WINDOW_HOURS=30

# Delay in ms between Futmondo calls. Clause discovery is one request per
# player, so this throttle is what keeps the account out of trouble. Default 300.
# FUTMONDO_MIN_INTERVAL_MS=300

# Manual fixes for scraped names that never match a Futmondo player.
# FUTMONDO_NAME_OVERRIDES={"Toni Martinez":"5b33408c744d2a591d3e566e"}

# Stable device id sent at login. Change only if you want a fresh session.
# FUTMONDO_DEVICE_ID=futmondobot-01

# Override the API host. For testing only.
# FUTMONDO_API_URL=https://api.futmondo.com
